generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  HOTEL_STAFF
  HOTEL_ADMIN
  SUPER_ADMIN
}

enum RoomType {
  // Legacy value kept for DB compat — do not use for new bookings
  AC_ROOM
  // Active category types
  NON_AC_ROOM
  PREMIUM_AC_ROOM
  CAVE_AC_ROOM
  PINEWOOD_COTTAGE
  THEATRE_COTTAGE
  LUXURY_COTTAGE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PORTAL
  WALK_IN
  PHONE
  MMT
  GOIBIBO
  BOOKING_COM
  OTHER
}

enum PaymentMode {
  CASH
  ONLINE
  MIXED
}

enum ConsentStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

enum ConsentMode {
  WHATSAPP
  PORTAL
}

enum IdType {
  AADHAR
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  FLAT
  PERCENT
}

enum CouponKind {
  INSTANT
  SEASONAL
}

enum OtpPurpose {
  CASH_COLLECTION
  EXPENSE_DEBIT
  DELETE_BOOKING
  DELETE_TRANSACTION
  DEPOSIT_DEDUCTION
  REFUND
  OTHER
}

enum OtpStatus {
  PENDING // admin requested, awaiting super admin
  ISSUED // super admin issued the code, awaiting admin entry
  USED // consumed successfully
  REJECTED // super admin declined
  EXPIRED // code expired before use
}

// ─── PLATFORM SUPER ADMIN ─────────────────────────────────────────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── HOTEL ────────────────────────────────────────────────────────────────────

model Hotel {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  email       String  @unique
  phone       String
  description String?
  address     String
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  starRating  Int     @default(3)
  gstin       String?
  panNumber   String?

  images    String[]
  amenities String[]

  checkInTime  String @default("12:00")
  checkOutTime String @default("11:00")

  // Reception kiosk staff-exit PIN (bcrypt hash; null = no PIN, exit passes through)
  kioskExitPinHash String?

  isActive       Boolean @default(true)
  isApproved     Boolean @default(false)
  commissionRate Float   @default(0)

  // Customer-facing payment options (super-admin controlled)
  allowPayAtHotel Boolean @default(true)
  allowPartialPay Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms           Room[]
  staff           HotelStaff[]
  bookings        Booking[]
  coupons         Coupon[]
  reviews         Review[]
  supportThreads  SupportThread[]
  otaSync         OtaChannelSync[]
  appsheetSync    AppsheetSyncLog[]
  cashCollections CashCollection[]
  expenses        HotelExpense[]
  inventory       RoomInventory[]
  promotions      PromotionScheme[]
  adminOtps       AdminOtp[]
  kioskDevices    KioskDevice[]
  kioskPairings   KioskPairingCode[]
}

// ─── KIOSK (reception self-check-in tablet) ───────────────────────────────────

// A paired reception device. Holds a scoped token that is accepted ONLY on the
// /api/kiosk/* endpoints — never a staff session. tokenHash is the SHA-256 of a
// high-entropy random token (the token itself is shown once, at pairing).
model KioskDevice {
  id         String    @id @default(cuid())
  hotelId    String
  name       String
  tokenHash  String    @unique
  isActive   Boolean   @default(true)
  pairedAt   DateTime  @default(now())
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId, isActive])
}

// Short-lived, single-use code an admin generates to pair a new device.
// Redeeming it mints a KioskDevice + token. `code` is the lookup key (6 digits),
// protected by short expiry, single use, and rate-limited redemption.
model KioskPairingCode {
  id        String    @id @default(cuid())
  hotelId   String
  name      String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

// The lookup→verify→check-in challenge for a single kiosk self-check-in.
// `token` is a high-entropy bearer id returned to the tablet; it becomes the
// check-in session credential once `status` flips to VERIFIED. Device-bound,
// attempt-limited, single-use, short-lived.
model KioskLookup {
  id        String   @id @default(cuid())
  token     String   @unique
  deviceId  String
  bookingId String
  method    String // "LAST4" | "OTP"
  otpHash   String? // bcrypt hash, when method = OTP
  status    String   @default("PENDING") // PENDING | VERIFIED | USED
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── HOTEL STAFF ──────────────────────────────────────────────────────────────

model HotelStaff {
  id         String  @id @default(cuid())
  hotelId    String
  name       String
  email      String  @unique
  password   String
  role       Role    @default(HOTEL_STAFF)
  phone      String?
  idPhotoUrl String? // optional ID document captured at registration
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

// ─── ROOM ─────────────────────────────────────────────────────────────────────

model Room {
  id          String     @id @default(cuid())
  hotelId     String
  roomNumber  String
  roomType    RoomType
  floor       Int?
  capacity    Int
  basePrice   Float
  description String?
  images      String[]
  amenities   String[]
  status      RoomStatus @default(AVAILABLE)
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel           Hotel      @relation(fields: [hotelId], references: [id])
  assignedBookings Booking[]  // bookings where this room has been physically assigned
  rates           RoomRate[]

  @@unique([hotelId, roomNumber])
}

// Seasonal / date-specific pricing overrides
model RoomRate {
  id       String   @id @default(cuid())
  roomId   String
  fromDate DateTime
  toDate   DateTime
  price    Float
  label    String?

  room Room @relation(fields: [roomId], references: [id])
}

// ─── GUEST (CUSTOMER ACCOUNT) ─────────────────────────────────────────────────

model Guest {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  name        String
  gender      Gender?
  dateOfBirth DateTime?
  address     String?
  occupation  String?
  idType      IdType?
  idNumber    String?
  idFrontUrl  String?
  idBackUrl   String?
  password    String?
  isVerified  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings         Booking[]          @relation("PrimaryGuest")
  companionIn      BookingCompanion[]
  consents         Consent[]          @relation("PrimaryConsent")
  secondaryConsent Consent[]          @relation("SecondaryConsent")
  reviews          Review[]
  onlineCheckins   OnlineCheckin[]
  supportThreads   SupportThread[]
}

// ─── BOOKING ──────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  bookingRef     String        @unique
  hotelId        String
  // Category booked by guest (always set). One of the RoomCategoryType strings.
  roomCategory   String        @default("LUXURY_COTTAGE")
  // Physical room assigned by admin after booking (null until assigned)
  roomId         String?
  // Links the rooms booked together in one cart checkout (null for single-room
  // bookings). The whole group shares one payment.
  bookingGroupId String?
  primaryGuestId String
  source         BookingSource @default(PORTAL)
  status         BookingStatus @default(PENDING_PAYMENT)

  // Explicit inventory-hold expiry for PENDING_PAYMENT bookings that need a longer
  // or custom window than the default 15-min createdAt one — e.g. phone bookings
  // awaiting payment via a WhatsApp link. null → the default window applies
  // (website checkout). Consumed by inventoryHoldFilter().
  holdExpiresAt  DateTime?

  checkInDate  DateTime
  checkOutDate DateTime
  noOfNights   Int
  noOfPersons  Int

  roomRent          Float
  couponDiscount    Float @default(0)
  refundableDeposit Float @default(0)   // EXPECTED deposit (₹200) — shown as "collected at check-in"; NOT in totalAmount for new bookings
  depositCollected  Float @default(0)   // ACTUAL deposit held (0 if skipped); set at check-in / counter booking
  depositMode       PaymentMode?        // how the deposit was taken (cash / online)

  // Deposit taken online via a Razorpay payment link sent on WhatsApp. Kept
  // apart from the room payment so checkout can refund the deposit straight
  // back to the account that paid it.
  depositLinkId     String?             // Razorpay payment-link id
  depositLinkUrl    String?             // short_url, so staff can resend it
  depositPaymentId  String?             // captured payment id — what we refund against
  additionalCharges Float @default(0)
  taxableAmount     Float @default(0)
  cgst              Float @default(0)
  sgst              Float @default(0)
  totalAmount       Float
  cashPaid          Float @default(0)
  onlinePaid        Float @default(0)
  balanceDue        Float @default(0)
  depositRefunded   Boolean @default(false)

  // Counter discount given by staff at their own discretion (separate from any
  // coupon). Applied to the FINAL GST-inclusive price, so the taxable base and
  // tax above are re-derived from the discounted gross. Attributed to the staff
  // member so the super-admin can review who discounted how much.
  staffDiscount    Float   @default(0)  // rupees off the final total (0 = none)
  originalTotal    Float?                // total before the staff discount
  discountedById   String?               // staff User.id
  discountedByName String?               // staff name at the time (snapshot)
  discountReason   String?
  discountedAt     DateTime?

  couponId        String?
  specialRequests String?
  guestGstin      String?
  guestPhone      String?   // phone entered at booking time (fallback when primaryGuest has no phone)

  // Taken by the owner over the phone in a few seconds — most details are
  // filled in later at check-in. Tagged so these are obvious in the list.
  instantBooking    Boolean   @default(false)

  onlineCheckinDone Boolean   @default(false)
  viaKiosk          Boolean   @default(false) // created or checked in at the reception kiosk
  checkedInAt       DateTime?
  checkedOutAt      DateTime?

  // Checkout deposit decision
  depositDeducted    Float   @default(0)   // amount actually deducted (can exceed deposit for damage)
  depositNotes       String?               // reason for deduction

  // Cancellation
  cancelledAt        DateTime?
  cancellationCharge Float?    // null = not cancelled; 0 = free; >0 = charged amount

  // Refund (post-cancellation). refundStatus: NONE | PENDING | PROCESSED | FAILED
  //   NONE      = nothing to refund (unpaid / pay-at-hotel)
  //   PENDING   = refund owed but not yet settled (auto-refund failed, or cash refund to hand back at desk)
  //   PROCESSED = refund completed (Razorpay refund issued, or staff marked a cash refund done)
  //   FAILED    = an auto-refund attempt errored; admin can retry
  refundStatus String    @default("NONE")
  refundAmount Float     @default(0)
  refundId     String?   // Razorpay refund id, when auto-refunded
  refundedAt   DateTime?

  appsheetBookingNo Int?
  appsheetConsentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  room         Room?              @relation(fields: [roomId], references: [id])
  primaryGuest Guest              @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  coupon       Coupon?            @relation(fields: [couponId], references: [id])
  companions   BookingCompanion[]
  consent      Consent?
  payment      Payment?
  gstInvoice   GstInvoice?
  // Archived ("deleted") by staff. The row, its payments and any GST invoice are
  // kept — a tax invoice is a legal record and its numbering must stay
  // unbroken — but an archived booking is invisible everywhere: lists, the room
  // board, availability, and the accounts statement. Reversible by a super admin.
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?
  deleteReason  String?

  charges      AdditionalCharge[]
  txns         BookingTxn[]
  onlineCheckin OnlineCheckin?
  syncLogs     AppsheetSyncLog[]

  @@index([bookingGroupId])
  @@index([hotelId, deletedAt])
}

// ─── STAFF ACTION LOG ─────────────────────────────────────────────────────────
// Sensitive desk actions used to need the owner's OTP before they could happen,
// which meant staff waiting on a phone to take cash out of the till or cancel a
// booking. They now go through immediately and are recorded here instead, with
// the owner notified on WhatsApp and by email as each one happens. The gate
// moved from before the action to after it: nothing is blocked, nothing is
// unseen.

enum StaffActionKind {
  PRICE_CHANGE       // a booking's total was edited after it was made
  DEPOSIT_CHANGE     // the refundable deposit on a booking was edited
  CASH_COLLECTION    // cash taken out of the till by the owner/staff
  EXPENSE_DEBIT      // money-out entry added to the ledger
  DELETE_TRANSACTION // a ledger entry removed
  CANCEL_BOOKING     // booking cancelled, usually with a refund
  DELETE_BOOKING     // booking removed from the panel
  DEPOSIT_DEDUCTION
  REFUND
  OTHER
}

model StaffActionLog {
  id      String          @id @default(cuid())
  hotelId String
  kind    StaffActionKind
  /// One line describing what happened, in the words the owner would use.
  summary String
  amount  Float?
  /// What it was done to, so the log can link back.
  refType String? // "booking" | "expense" | "collection"
  refId   String?
  /// Denormalised so the log stays searchable and readable even after the thing
  /// it refers to is itself deleted.
  bookingRef String?
  guestName  String?
  reason     String?

  actorId   String?
  actorName String
  actorRole String

  details Json?

  /// Whether the owner's WhatsApp and email actually went out. A false here is
  /// the case worth looking at — the action happened but nobody was told.
  notifiedWhatsapp Boolean @default(false)
  notifiedEmail    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([hotelId, kind])
  @@index([bookingRef])
}

// ─── BOOKING TRANSACTION ──────────────────────────────────────────────────────
// One row per movement of money, written at the moment it happens and never
// edited afterwards. The Booking's own cashPaid/onlinePaid are running totals:
// they say how much has been paid, but not when, in how many instalments, or by
// whom — so a guest who pays ₹500 at booking and the rest at check-in used to
// appear in the accounts statement as a single payment dated at booking. This
// table is what the statement reads, so every instalment shows on its own date.

enum TxnKind {
  ROOM_PAYMENT     // paid towards the room bill
  EXTRA_CHARGE     // paid at the counter for an extra (water, food, …)
  DEPOSIT_APPLIED  // deposit money used to settle what the guest owed
  DEPOSIT_WITHHELD // deposit money kept back for dirt or damage
  CANCELLATION_FEE // retained when a booking was cancelled
  REFUND           // money returned to the guest
}

enum TxnMode {
  CASH
  ONLINE
  DEPOSIT // settled out of the deposit already held — no money changed hands at the desk
}

model BookingTxn {
  id         String   @id @default(cuid())
  hotelId    String
  bookingId  String
  kind       TxnKind
  mode       TxnMode
  amount     Float
  /// Signed effect on the physical cash drawer. Cash taken is +, cash handed
  /// back is −, and anything online or on paper is 0. Deposit money only lands
  /// here when it stops being the guest's — i.e. when it is applied or withheld.
  cashImpact Float    @default(0)
  note       String?
  occurredAt DateTime
  recordedBy String?
  /// Stable key for events that could be replayed (webhook retries, a double
  /// submit at the desk), so the same rupee is never recorded twice.
  idemKey    String?  @unique
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([hotelId, occurredAt])
  @@index([bookingId, occurredAt])
}

// ─── BOOKING COMPANION ────────────────────────────────────────────────────────

model BookingCompanion {
  id         String  @id @default(cuid())
  bookingId  String
  guestId    String?
  name       String
  relation   String?
  idType     IdType?
  idNumber   String?
  idFrontUrl String?
  idBackUrl  String?

  booking Booking @relation(fields: [bookingId], references: [id])
  guest   Guest?  @relation(fields: [guestId], references: [id])
}

// ─── ONLINE CHECK-IN ──────────────────────────────────────────────────────────

model OnlineCheckin {
  id                   String    @id @default(cuid())
  bookingId            String    @unique
  guestId              String
  comingFrom           String?
  goingTo              String?
  purpose              String?
  vehicleNo            String?
  expectedCheckInTime  String?
  expectedCheckOutTime String?
  completedAt          DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])
  guest   Guest   @relation(fields: [guestId], references: [id])
}

// ─── CONSENT ──────────────────────────────────────────────────────────────────

model Consent {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  primaryGuestId      String
  secondaryGuestId    String?
  status              ConsentStatus @default(PENDING)
  secondaryStatus     ConsentStatus?
  mode                ConsentMode   @default(PORTAL)
  pdfUrl              String?
  sentAt              DateTime?
  primaryAcceptedAt   DateTime?
  secondaryAcceptedAt DateTime?
  consentToken        String?
  // Staff who verified a physically-signed consent copy (null for electronic
  // guest acceptance). Name is snapshotted so it survives staff record changes.
  verifiedById        String?
  verifiedByName      String?

  booking        Booking @relation(fields: [bookingId], references: [id])
  primaryGuest   Guest   @relation("PrimaryConsent", fields: [primaryGuestId], references: [id])
  secondaryGuest Guest?  @relation("SecondaryConsent", fields: [secondaryGuestId], references: [id])
}

// ─── PAYMENT ──────────────────────────────────────────────────────────────────

model Payment {
  id                String      @id @default(cuid())
  bookingId         String      @unique
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  razorpayLinkId    String?     // Razorpay Payment Link id (phone bookings paid via WhatsApp link)
  amount            Float
  currency          String      @default("INR")
  mode              PaymentMode
  status            String      @default("pending")
  paidAt            DateTime?
  refundedAt        DateTime?
  refundAmount      Float?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── ADDITIONAL CHARGES ───────────────────────────────────────────────────────

model AdditionalCharge {
  id          String      @id @default(cuid())
  bookingId   String
  chargeTypes String[]
  description String?
  quantity    Float       @default(1)
  unitPrice   Float
  amount      Float
  mode        PaymentMode @default(CASH)
  // true  = guest paid for it there and then (mode says cash/UPI), so it never
  //         touches the deposit.
  // false = left on the tab, offset against the refundable deposit at checkout.
  paidNow     Boolean     @default(false)
  addedAt     DateTime    @default(now())
  addedBy     String?

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── GST INVOICE ──────────────────────────────────────────────────────────────

model GstInvoice {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  invoiceNumber     String   @unique
  customerName      String
  customerPhone     String
  customerGstin     String?
  roomNo            String
  checkIn           DateTime
  checkOut          DateTime
  roomRent          Float
  additionalCharges Float    @default(0)
  couponDiscount    Float    @default(0)
  taxableAmount     Float
  cgst              Float
  sgst              Float
  totalAmount       Float
  generatedAt       DateTime @default(now())
  pdfUrl            String?

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── COUPON ───────────────────────────────────────────────────────────────────

model Coupon {
  id            String       @id @default(cuid())
  hotelId       String?
  code          String       @unique
  kind          CouponKind   @default(INSTANT)
  discountType  DiscountType
  discountValue Float
  minAmount     Float        @default(0)
  maxDiscount   Float?
  maxUses       Int?
  usedCount     Int          @default(0)
  referrerName  String?
  label         String? // human-friendly description shown to staff
  validFrom     DateTime?
  expiryDate    DateTime?
  isActive      Boolean      @default(true)
  createdBy     String? // super admin name
  promotionId   String?

  // ── Marketing / universal discount ──
  // isUniversal: the single hotel-wide "marketing" discount, auto-applied to every
  // guest and shown as a struck-through base price. Only one should be active per hotel.
  // autoApply:   applied automatically without the guest entering a code.
  // stacksOnUniversal: for regular coupons — when true (default), the coupon discount
  //   stacks on TOP of the universal discount (computed on the already-discounted price);
  //   when false, the coupon applies to the base price only and the universal is ignored.
  isUniversal       Boolean @default(false)
  autoApply         Boolean @default(false)
  stacksOnUniversal Boolean @default(true)

  createdAt DateTime @default(now())

  hotel     Hotel?           @relation(fields: [hotelId], references: [id])
  promotion PromotionScheme? @relation(fields: [promotionId], references: [id])
  bookings  Booking[]
}

// ─── PASSWORD RESET ───────────────────────────────────────────────────────────
// One active reset per phone (the customer login identifier). The OTP is sent
// over WhatsApp and stored only as a bcrypt hash.
model PasswordReset {
  phone     String   @id
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── REVIEW ───────────────────────────────────────────────────────────────────

model Review {
  id             String  @id @default(cuid())
  hotelId        String
  guestId        String
  bookingId      String? @unique
  rating         Int
  title          String?
  comment        String?
  isVerifiedStay Boolean @default(false)
  isVisible      Boolean @default(true)

  createdAt DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  guest   Guest   @relation(fields: [guestId], references: [id])
}

// ─── APPSHEET SYNC LOG ────────────────────────────────────────────────────────

model AppsheetSyncLog {
  id        String     @id @default(cuid())
  hotelId   String
  bookingId String?
  action    String
  status    SyncStatus @default(PENDING)
  payload   Json?
  response  Json?
  error     String?
  attempts  Int        @default(0)
  syncedAt  DateTime?
  createdAt DateTime   @default(now())

  hotel   Hotel    @relation(fields: [hotelId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

// ─── CASH COLLECTION (owner withdrawals from till) ────────────────────────────

model CashCollection {
  id          String   @id @default(cuid())
  hotelId     String
  amount      Float
  note        String?
  collectedBy String?
  createdAt   DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

// ─── HOTEL EXPENSE / MANUAL LEDGER ENTRY ─────────────────────────────────────

model HotelExpense {
  id          String      @id @default(cuid())
  hotelId     String
  entryType   String      // "DEBIT" | "CREDIT"
  category    String      // e.g. "Electricity", "Plumber", "Salary"
  description String?
  amount      Float
  mode        PaymentMode @default(CASH)
  expenseDate DateTime    @default(now())
  addedBy     String?
  createdAt   DateTime    @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])
}

// ─── OTA CHANNEL SYNC (future) ────────────────────────────────────────────────

model OtaChannelSync {
  id           String   @id @default(cuid())
  hotelId      String
  channel      String
  apiKey       String?
  propertyId   String?
  syncEnabled  Boolean  @default(false)
  lastSyncedAt DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, channel])
}

// ─── ROOM INVENTORY (date-wise availability override per category) ────────────
// units = number of bookable rooms of this category on this specific date.
// Absence of a row = use the category's default room count.
model RoomInventory {
  id        String   @id @default(cuid())
  hotelId   String
  roomType  RoomType
  date      DateTime @db.Date
  units     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, roomType, date])
  @@index([hotelId, date])
}

// ─── PROMOTION SCHEME (seasonal campaigns; groups coupons) ────────────────────
model PromotionScheme {
  id            String       @id @default(cuid())
  hotelId       String?
  name          String
  keyword       String? // optional reference keyword baked into coupon codes
  description   String?
  discountType  DiscountType
  discountValue Float
  minAmount     Float        @default(0)
  maxDiscount   Float?
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean      @default(true)
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  hotel   Hotel?   @relation(fields: [hotelId], references: [id])
  coupons Coupon[]
}

// ─── ADMIN OTP (super-admin authorisation for debits & deletes) ───────────────
// Flow: admin requests (PENDING) → super admin issues code (no expiry)
//        → admin enters code in Pending Approvals → action executes (USED).
// OTPs never expire — super admin approves when free; admin completes at any time.
model AdminOtp {
  id            String     @id @default(cuid())
  hotelId       String
  purpose       OtpPurpose
  description   String // human-readable summary shown to the super admin
  amount        Float?
  refId         String? // entity being acted on (booking id, transaction id, …)
  actionPayload Json? // full payload needed to re-execute the action on OTP entry
  code          String? // 6-digit, set when issued
  status        OtpStatus  @default(PENDING)
  requestedBy   String?
  issuedBy      String?
  issuedAt      DateTime?
  expiresAt     DateTime? // kept for DB compat; no longer set or checked
  usedAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId, status])
}

// ─── CUSTOMER SUPPORT CHAT ────────────────────────────────────────────────────

enum SupportStatus {
  OPEN
  CLOSED
}

// One thread per guest per hotel. Guests initiate; staff reply from admin panel.
model SupportThread {
  id        String        @id @default(cuid())
  hotelId   String
  guestId   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  hotel    Hotel           @relation(fields: [hotelId], references: [id])
  guest    Guest           @relation(fields: [guestId], references: [id])
  messages SupportMessage[]

  @@unique([hotelId, guestId])
  @@index([hotelId, status])
}

model SupportMessage {
  id         String   @id @default(cuid())
  threadId   String
  senderRole String   // "CUSTOMER" | "STAFF"
  senderName String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
